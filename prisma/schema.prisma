// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../docs/ERD.md"
}

enum Size {
  TINY
  SMALL
  MEDIUM
  LARGE
  HUGE
  GARGANTUAN
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
  REFUNDED
}

model Race {
  id    String @id @default(uuid(7))
  name  String @unique
  speed Int
  size  Size   @default(MEDIUM)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subraces   Subrace[]
  languages  Language[]
  characters Character[]

  @@map("races")
}

model Subrace {
  id   String @id @default(uuid(7))
  name String

  raceId String @map("race_id")
  race   Race   @relation(fields: [raceId], references: [id], onDelete: Cascade)

  characters Character[]

  @@unique([raceId, name])
  @@map("subraces")
}

model CharacterClass {
  id     String @id @default(uuid(7))
  name   String @unique
  hitDie Int    @map("hit_die")

  characters Character[]

  @@map("character_classes")
}

model Background {
  id          String  @id @default(uuid(7))
  name        String  @unique
  description String?

  characters Character[]

  @@map("backgrounds")
}

model Language {
  id   String @id @default(uuid(7))
  name String @unique

  races      Race[]
  characters Character[]

  @@map("languages")
}

model Character {
  id    String @id @default(uuid(7))
  name  String
  level Int    @default(1)

  strength     Int @default(10)
  dexterity    Int @default(10)
  constitution Int @default(10)
  intelligence Int @default(10)
  wisdom       Int @default(10)
  charisma     Int @default(10)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  raceId String @map("race_id")
  race   Race   @relation(fields: [raceId], references: [id])

  subraceId String?  @map("subrace_id")
  subrace   Subrace? @relation(fields: [subraceId], references: [id])

  characterClassId String         @map("character_class_id")
  characterClass   CharacterClass @relation(fields: [characterClassId], references: [id])

  backgroundId String     @map("background_id")
  background   Background @relation(fields: [backgroundId], references: [id])

  languages Language[]

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([raceId])
  @@index([characterClassId])
  @@index([backgroundId])
  @@index([userId])
  @@map("characters")
}

model User {
  id           String @id @default(uuid(7))
  name         String
  email        String @unique
  passwordHash String @map("password_hash")

  premiumUntil DateTime? @map("premium_until")

  /// Soft Delete. Never just remove the user account on first attempt. Wait for 6 weeks or more to delete
  /// we mark as inactive to search, and when the users try to recover or create a new account, we should give
  /// option to recover his previous account.
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  characters Character[]
  payments   Payment[]

  @@map("users")
}

model Payment {
  id String @id @default(uuid(7))

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  externalPayment String        @unique @map("external_payment")
  status          PaymentStatus @default(PENDING)

  amountCents Int    @map("amount_cents")
  currency    String @default("BRL")

  paidAt    DateTime? @map("paid_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("payments")
}
