{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"outDir": "dist",
		"rootDir": "src",

		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"verbatimModuleSyntax": true,

		"esModuleInterop": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"declaration": false
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
